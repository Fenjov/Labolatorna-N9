<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lab9Avalonia.MainWindow"
        Title="Лабораторна робота №9 - Варіант 8" Width="420" Height="420">

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Розрахунок індексу маси тіла (ІМТ)" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>

        <Separator Height="2" Background="LightGray"/>

        <StackPanel Name="InputPanel" Spacing="10">
            <TextBlock Text="Вага (кг):"/>
            <TextBox Name="txtWeight" Watermark="Наприклад: 72.5 або 72"/>
            
            <TextBlock Text="Зріст (см):"/>
            <TextBox Name="txtHeight" Watermark="Наприклад: 178"/>
        </StackPanel>

        <Button Content="Розрахувати ІМТ" Width="150" HorizontalAlignment="Center" Click="OnCalculateClick"/>

        <Separator Height="2" Background="LightGray"/>

        <TextBlock Name="txtResult" Text="Результат: " FontSize="14" FontWeight="Bold" Foreground="DarkBlue" TextWrapping="Wrap"/>
    </StackPanel>
</Window>